{
  "name": "@gansotech/astro-datasource-gitlab",
  "version": "0.3.2",
  "description": "Astro content loader that fetches Markdown docs and their assets from a GitLab repository over the REST API. Built for Starlight docs sites, works with any content collection.",
  "keywords": [
    "astro",
    "withastro",
    "astro-loader",
    "starlight",
    "gitlab",
    "documentation"
  ],
  "license": "MIT",
  "author": "Ganso Technologies",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ganso-technologies/astro-datasource-gitlab.git"
  },
  "bugs": {
    "url": "https://github.com/ganso-technologies/astro-datasource-gitlab/issues"
  },
  "homepage": "https://github.com/ganso-technologies/astro-datasource-gitlab#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"No linter configured yet\"",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "astro": ">=5.9.0"
  },
  "dependencies": {
    "picomatch": "^4.0.2",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/picomatch": "^4.0.0",
    "astro": "^7.0.2",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
